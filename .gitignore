__pycache__/
*.pyc
.venv/
.pytest_cache/

# engine state — the ledger and register are MACHINE state, not evidence.
# Committing them would merge two PCs' trial counts into a wrong total.
state/
*.local.json

# harvested store is machine state; the seed is the reproducible input
state/candidates.db
state/translations/
state/ledger.json
.env
state/pine/

# generated every pass by the runner — machine output, not source
dashboard/strategies.json
dashboard/activity.json
dashboard/implementation-activity.json
dashboard/history.json
RESULTS.md
state/notified.json

# Generated console data — machine-local, same reason as state/.
# Committing it would conflict between the two PCs on every pass.
dashboard/strategies.json
dashboard/pipeline.json
dashboard/*.json.tmp
